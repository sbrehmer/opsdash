{
  "name": "@opsdash/plugin-delivery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "opsdash": {
    "id": "delivery",
    "apiVersion": "^1.1.0",
    "server": "server.js",
    "client": "client.js",
    "capabilities": [
      "actions"
    ],
    "env": [],
    "refresh": {
      "interval": "60s",
      "timeout": "10s"
    },
