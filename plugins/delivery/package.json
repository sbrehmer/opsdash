      "jenkins",
      "jira"
    ]
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opsdash/delivery-cells": "workspace:*",
    "@opsdash/plugin-sdk": "workspace:*",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "vite": "^8.3.1"
  }
}
